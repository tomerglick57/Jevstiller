---
// One task learned live from Jev (Banking77 replay): how much is answered locally as it learns, and agreement
// with Jev against the target. Two small multiples on a shared x axis, rendered at build time as inline SVG.
// A small script adds a hover crosshair with the values at the nearest checkpoint.
import data from '../data/banking77-live.json';

const W = 720, H = 372;
const left = 62, right = 704;                       // plot area, x
const top1 = 30, bottom1 = 200;                     // panel 1: answered locally, 0-100%
const top2 = 252, bottom2 = 328;                    // panel 2: agreement, 97-100%
const xMax = 11_500;
const x = (m: number) => left + (m / xMax) * (right - left);
const y1 = (v: number) => bottom1 - v * (bottom1 - top1);
const aLo = 0.97, aHi = 1.0;
const y2 = (v: number) => bottom2 - ((v - aLo) / (aHi - aLo)) * (bottom2 - top2);

const pts = data.points;
const local = pts.map((p) => [x(p.messages), y1(p.answered_locally)] as const);
const localLine = [[x(0), y1(0)], ...local].map(([a, b]) => `${a.toFixed(1)},${b.toFixed(1)}`).join(' ');
const localArea = `${x(0)},${y1(0)} ${localLine} ${local.at(-1)![0].toFixed(1)},${y1(0)}`;
const agreePts = pts.filter((p) => p.agreement != null);
const agree = agreePts.map((p) => [x(p.messages), y2(p.agreement!)] as const);
const agreeLine = agree.map(([a, b]) => `${a.toFixed(1)},${b.toFixed(1)}`).join(' ');
const firstStudent = pts.find((p) => p.student)!.messages;
const learnEnd = x((pts.filter((p) => !p.student).at(-1)!.messages + firstStudent) / 2);
const last = pts.at(-1)!;
const agreements = agreePts.map((p) => p.agreement!);
const pct = (v: number, d = 1) => `${(v * 100).toFixed(d)}%`;
const xTicks = [0, 2500, 5000, 7500, 10000];
const fmt = (n: number) => n.toLocaleString('en-US');
// what the hover layer needs: the x position of each checkpoint and its values
const hover = pts.map((p) => ({ x: x(p.messages), m: p.messages, l: p.answered_locally, a: p.agreement, s: p.student }));
---

<div class="rc-box" data-points={JSON.stringify(hover)} data-w={W}>
	<svg class="rc" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="rc-title rc-desc">
		<title id="rc-title">One task, learned live from Jev</title>
		<desc id="rc-desc">
			Over {fmt(data.messages)} messages, the share answered locally rises from 0% to {pct(last.answered_locally)},
			while agreement with Jev stays between {pct(Math.min(...agreements), 2)} and {pct(Math.max(...agreements), 2)}, above
			the {pct(data.target, 0)} target.
		</desc>

		<!-- panel 1: answered locally -->
		<rect class="rc-learn" x={x(0)} y={top1} width={learnEnd - x(0)} height={bottom1 - top1} />
		<text class="rc-note" x={x(0) + 8} y={top1 + 16}>learning</text>
		<text class="rc-note" x={x(0) + 8} y={top1 + 30}>all to Jev</text>
		{[0, 0.25, 0.5, 0.75, 1].map((v) => (
			<>
				<line class="rc-grid" x1={left} x2={right} y1={y1(v)} y2={y1(v)} />
				<text class="rc-tick" x={left - 8} y={y1(v) + 4} text-anchor="end">{pct(v, 0)}</text>
			</>
		))}
		<polygon class="rc-area" points={localArea} />
		<polyline class="rc-local" points={localLine} />
		{local.map(([a, b]) => <circle class="rc-local-pt" cx={a} cy={b} r="4.5" />)}
		<text class="rc-value" x={local.at(-1)![0] - 4} y={local.at(-1)![1] - 14} text-anchor="end">
			{pct(last.answered_locally)} answered locally
		</text>
		<text class="rc-axis" x={left} y={top1 - 10}>Answered locally, without calling Jev</text>

		<!-- panel 2: agreement -->
		{[0.97, 0.98, 0.99, 1].map((v) => (
			<>
				<line class={v === data.target ? 'rc-target' : 'rc-grid'} x1={left} x2={right} y1={y2(v)} y2={y2(v)} />
				<text class="rc-tick" x={left - 8} y={y2(v) + 4} text-anchor="end">{pct(v, 0)}</text>
			</>
		))}
		<text class="rc-target-text" x={right} y={y2(data.target) + 14} text-anchor="end">target {pct(data.target, 0)}</text>
		<polyline class="rc-agree" points={agreeLine} />
		{agree.map(([a, b]) => <circle class="rc-agree-pt" cx={a} cy={b} r="4.5" />)}
		<text class="rc-value" x={agree.at(-1)![0] - 4} y={agree.at(-1)![1] - 12} text-anchor="end">
			{pct(last.agreement!, 2)} agreement
		</text>
		<text class="rc-axis" x={left} y={top2 - 12}>Agreement with Jev, on {fmt(data.held_out)} held-out messages</text>

		<!-- shared x axis -->
		{xTicks.map((m) => (
			<text class="rc-tick" x={x(m)} y={bottom2 + 20} text-anchor="middle">{fmt(m)}</text>
		))}
		<text class="rc-axis" x={(left + right) / 2} y={H - 6} text-anchor="middle">messages seen</text>

		<line class="rc-cross" x1="0" x2="0" y1={top1} y2={bottom2} visibility="hidden" />
		<rect class="rc-hit" x={left} y={top1} width={right - left} height={bottom2 - top1} fill="transparent" />
	</svg>
	<div class="rc-tip" hidden></div>
</div>

<style is:global>
	/* Colours come from the page: the landing page sets --lp-*; anywhere else, Starlight's own palette is used. */
	.rc-box {
		--rc-ink: var(--lp-ink, var(--sl-color-white));
		--rc-ink-2: var(--lp-ink-2, var(--sl-color-gray-2));
		--rc-muted: var(--lp-muted, var(--sl-color-gray-3));
		--rc-grid: var(--lp-line-soft, var(--sl-color-gray-6));
		--rc-surface: var(--lp-surface, var(--sl-color-bg));
		--rc-local: var(--lp-accent, var(--sl-color-accent));
		--rc-agree: var(--lp-violet, var(--sl-color-purple));
		--rc-target: var(--lp-amber, var(--sl-color-orange));
		--rc-border: var(--lp-line, var(--sl-color-gray-5));
		--rc-font: var(--lp-mono, var(--sl-font-mono, ui-monospace, monospace));
		position: relative;
	}
	.rc { width: 100%; height: auto; display: block; font-family: var(--rc-font); }
	.rc text { fill: var(--rc-ink-2); font-size: 11.5px; }
	.rc-tick { font-size: 11px; fill: var(--rc-muted); }
	.rc-note { fill: var(--rc-muted); font-size: 11px; }
	.rc-axis { fill: var(--rc-ink); font-size: 12px; font-weight: 500; }
	.rc-value { fill: var(--rc-ink); font-size: 12.5px; font-weight: 700; }
	.rc-target-text { fill: var(--rc-target); font-size: 11px; }
	.rc-grid { stroke: var(--rc-grid); stroke-width: 1; }
	.rc-learn { fill: var(--rc-ink); opacity: 0.04; }
	.rc-target { stroke: var(--rc-target); stroke-width: 1.5; stroke-dasharray: 4 4; }
	.rc-area { fill: var(--rc-local); opacity: 0.12; }
	.rc-local { fill: none; stroke: var(--rc-local); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
	.rc-local-pt { fill: var(--rc-local); stroke: var(--rc-surface); stroke-width: 2; }
	.rc-agree { fill: none; stroke: var(--rc-agree); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
	.rc-agree-pt { fill: var(--rc-agree); stroke: var(--rc-surface); stroke-width: 2; }
	.rc-cross { stroke: var(--rc-ink-2); stroke-width: 1; stroke-dasharray: 2 3; pointer-events: none; }
	.rc-tip {
		position: absolute; pointer-events: none; min-width: 190px; display: grid; gap: 2px;
		background: var(--rc-surface); color: var(--rc-ink-2); border: 1px solid var(--rc-border); border-radius: 6px;
		padding: 8px 10px; font: 12px/1.5 var(--rc-font); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
	}
	.rc-tip[hidden] { display: none; }
	.rc-tip b { color: var(--rc-ink); font-weight: 500; }
	.rc-tip span { display: flex; justify-content: space-between; gap: 12px; }
</style>

<script>
	// hover: a crosshair at the nearest checkpoint, and a tooltip with its values
	const pct = (v: number, d = 1) => `${(v * 100).toFixed(d)}%`;
	for (const box of document.querySelectorAll<HTMLElement>('.rc-box')) {
		const pts = JSON.parse(box.dataset.points!) as { x: number; m: number; l: number; a: number | null; s: string | null }[];
		const W = Number(box.dataset.w);
		const svg = box.querySelector('svg')!;
		const cross = box.querySelector<SVGLineElement>('.rc-cross')!;
		const hit = box.querySelector<SVGRectElement>('.rc-hit')!;
		const tip = box.querySelector<HTMLElement>('.rc-tip')!;
		hit.addEventListener('mousemove', (ev) => {
			const r = svg.getBoundingClientRect();
			const mx = (ev.clientX - r.left) * (W / r.width);
			const best = pts.reduce((a, b) => (Math.abs(b.x - mx) < Math.abs(a.x - mx) ? b : a));
			cross.setAttribute('x1', String(best.x));
			cross.setAttribute('x2', String(best.x));
			cross.setAttribute('visibility', 'visible');
			tip.hidden = false;
			tip.innerHTML =
				`<b>${best.m.toLocaleString('en-US')} messages</b>` +
				`<span>answered locally <b>${pct(best.l)}</b></span>` +
				`<span>agreement <b>${best.a == null ? 'no student yet' : pct(best.a, 2)}</b></span>` +
				(best.s ? `<span>${best.s}</span>` : '');
			const px = (best.x / W) * r.width;
			tip.style.left = `${Math.min(px + 12, r.width - tip.offsetWidth - 4)}px`;
			tip.style.top = `${ev.clientY - r.top - 10}px`;
		});
		hit.addEventListener('mouseleave', () => {
			cross.setAttribute('visibility', 'hidden');
			tip.hidden = true;
		});
	}
</script>
